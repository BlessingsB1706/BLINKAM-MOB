# Copy to .env and fill in. .env is git-ignored — NEVER commit real values.
#
# SERVER-SIDE SECRETS ONLY. These must never be placed in config.js or any
# HTML file, because everything shipped to the browser is public.
# Use them from a backend / Supabase Edge Function (e.g. a Dojah webhook
# handler that confirms a verification before marking a user as verified).

# Dojah — https://app.dojah.io  (Developers > Configuration)
DOJAH_APP_ID=
DOJAH_SECRET_KEY=
DOJAH_BASE_URL=https://sandbox.dojah.io

# Supabase — Project Settings > API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
